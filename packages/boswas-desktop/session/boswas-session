#!/bin/sh
# boswas-session: the Boswas OS desktop session.
#
# Started by greetd after a successful login (and by the live session's
# automatic login). It prepares the environment, starts the compositor,
# which starts the shell, and ends the session when the compositor exits.
#
# This replaces startplasma-wayland.

# The login profile, as a display manager would source it. Errors in a
# user's profile must not prevent login.
if [ -z "${BOSWAS_SESSION_PROFILE:-}" ]; then
	export BOSWAS_SESSION_PROFILE=1
	for profile in /etc/profile "$HOME/.profile"; do
		# A file with a syntax error would end this script when it is
		# sourced, and with it the login: such a file is skipped.
		# shellcheck disable=SC1090
		[ -r "$profile" ] && sh -n "$profile" 2>/dev/null && . "$profile" 2>/dev/null
	done
fi

export XDG_CURRENT_DESKTOP=Boswas
export XDG_SESSION_DESKTOP=boswas
export XDG_SESSION_TYPE=wayland

# Toolkits: draw on Wayland directly.
export QT_QPA_PLATFORM="wayland;xcb"
export GDK_BACKEND=wayland
export MOZ_ENABLE_WAYLAND=1
export SDL_VIDEODRIVER=wayland
export CLUTTER_BACKEND=wayland
export _JAVA_AWT_WM_NONREPARENTING=1
export XCURSOR_THEME="${XCURSOR_THEME:-Boswas-Cursors}"

# The pointer size: [pointer] cursor_size of the compositor's configuration
# (boswas-compositor(1)), from the last of its files that sets it, as the
# compositor reads them (a file above 256 KiB is skipped), 16 to 96, 24 when
# none does. The compositor draws its own pointer at this size; X11 programs
# and programs that draw their own pointer read XCURSOR_SIZE, so it follows
# the setting (Settings > Mouse, Accessibility > Mouse pointer), not the
# environment of the login. Settings also changes the user manager's copy
# when the size changes, for programs started after that.
# BEGIN cursor_size
cursor_size() {
	size=24
	for file in "$@"; do
		if [ ! -f "$file" ] || [ ! -r "$file" ]; then
			continue
		fi
		[ "$(wc -c <"$file" 2>/dev/null || echo 262145)" -le 262144 ] || continue
		value=$(awk '
			/^[ \t]*\[/ {
				table = $0
				sub(/^[ \t]*\[[ \t]*/, "", table)
				sub(/[ \t]*\].*$/, "", table)
				next
			}
			(table == "pointer" && /^[ \t]*cursor_size[ \t]*=/) ||
			(table == "" && /^[ \t]*pointer\.cursor_size[ \t]*=/) {
				value = $0
				sub(/^[^=]*=[ \t]*/, "", value)
				sub(/[ \t]*(#.*)?\r?$/, "", value)
				if (value ~ /^[0-9]+$/) found = value + 0
			}
			END {
				if (found != "") {
					if (found < 16) found = 16
					if (found > 96) found = 96
					print found
				}
			}' "$file" 2>/dev/null)
		[ -n "$value" ] && size=$value
	done
	echo "$size"
}
# END cursor_size
case "${XDG_CONFIG_HOME:-}" in
	/*) user_config="$XDG_CONFIG_HOME" ;;
	*) user_config="$HOME/.config" ;;
esac
XCURSOR_SIZE=$(cursor_size /usr/share/boswas/compositor/compositor.toml /etc/boswas/compositor.toml \
	"$user_config/boswas/compositor.toml")
export XCURSOR_SIZE

# Boswas defaults for KDE applications (colour scheme, icon theme). The
# directory is appended, so /etc/xdg and the user's own settings win.
case ":${XDG_CONFIG_DIRS:-}:" in
	*:/usr/share/boswas/kde-settings:*) ;;
	*) XDG_CONFIG_DIRS="${XDG_CONFIG_DIRS:-/etc/xdg}:/usr/share/boswas/kde-settings" ;;
esac
export XDG_CONFIG_DIRS

# A session bus is needed by nearly every application. With
# dbus-user-session the user manager provides it; otherwise start one.
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && [ ! -S "${XDG_RUNTIME_DIR:-/nonexistent}/bus" ] &&
	[ -z "${BOSWAS_SESSION_BUS:-}" ] && command -v dbus-run-session >/dev/null 2>&1; then
	export BOSWAS_SESSION_BUS=1
	exec dbus-run-session -- "$0" "$@"
fi

compositor=/usr/bin/boswas-compositor
ready=/usr/libexec/boswas/boswas-session-ready

# The messages of the compositor and of what it starts go to the journal
# ("journalctl -b -t boswas-session"), not onto the console behind the
# desktop. systemd-cat runs the compositor in its own place, so the exit
# status is the compositor's.
log=""
[ -S /run/systemd/journal/stdout ] && [ -x /usr/bin/systemd-cat ] &&
	log="/usr/bin/systemd-cat --identifier=boswas-session"

# shellcheck disable=SC2086
$log "$compositor" "$@" -- "$ready"
status=$?
if [ "$status" -ne 0 ]; then
	echo "boswas-session: the desktop ended with status $status" >&2
	[ -n "$log" ] && echo "boswas-session: why: journalctl -b -t boswas-session" >&2
fi

# The session is over: stop what was started for it.
if command -v systemctl >/dev/null 2>&1; then
	systemctl --user stop boswas-session.target 2>/dev/null
	systemctl --user unset-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP \
		XDG_SESSION_TYPE QT_QPA_PLATFORM GDK_BACKEND MOZ_ENABLE_WAYLAND 2>/dev/null
fi
exit "$status"
