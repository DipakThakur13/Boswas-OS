[Unit]
Description=Show the Boswas OS boot screen
Documentation=man:boswas-bootsplashd(8)
DefaultDependencies=no
Wants=boswas-bootsplash-ask-password.path
After=systemd-udev-trigger.service systemd-udevd.service systemd-vconsole-setup.service
Before=sysinit.target boswas-bootsplash-ask-password.service
ConditionKernelCommandLine=splash
ConditionKernelCommandLine=!nosplash
ConditionVirtualization=!container
IgnoreOnIsolate=true

[Service]
# Normally the boot screen is already up (started in the initramfs) and this
# returns at once. Otherwise the daemon detaches and keeps running after
# this command has returned; boswas-bootsplash-quit.service ends it.
Type=oneshot
RemainAfterExit=yes
ExecStart=-/usr/libexec/boswas/boswas-bootsplashd --mode=boot
TimeoutStartSec=20
