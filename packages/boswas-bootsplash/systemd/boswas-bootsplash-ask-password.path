[Unit]
Description=Forward password requests to the Boswas OS boot screen (directory watch)
Documentation=man:boswas-bootsplash(1)
DefaultDependencies=no
Conflicts=shutdown.target emergency.service
After=boswas-bootsplash-start.service
Before=paths.target shutdown.target cryptsetup.target
ConditionPathExists=/run/boswas-bootsplash/pid
ConditionVirtualization=!container

[Path]
DirectoryNotEmpty=/run/systemd/ask-password
MakeDirectory=yes
