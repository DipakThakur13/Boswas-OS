[Unit]
Description=Forward password requests to the Boswas OS boot screen
Documentation=man:boswas-bootsplash(1)
DefaultDependencies=no
Conflicts=shutdown.target emergency.service
After=boswas-bootsplash-start.service systemd-vconsole-setup.service
Before=shutdown.target
ConditionPathExists=/run/boswas-bootsplash/pid

[Service]
ExecStart=/usr/bin/boswas-bootsplash agent
