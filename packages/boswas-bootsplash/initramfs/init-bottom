#!/bin/sh
# Tell the Boswas OS boot screen that the system is moving to its real root
# (installed as /usr/share/initramfs-tools/scripts/init-bottom/boswas-bootsplash).
# The worker follows, so its paths (the graphics devices, its socket) still
# lead somewhere after the initramfs is gone. Its supervisor needs no such
# message: it works through directories it opened at start. Runs after udev
# has moved /dev.

PREREQ="udev"

prereqs()
{
	echo "${PREREQ}"
}

case "${1}" in
	prereqs)
		prereqs
		exit 0
		;;
esac

# shellcheck disable=SC2154
/usr/bin/boswas-bootsplash new-root "${rootmnt}" || true
