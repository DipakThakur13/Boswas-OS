#!/bin/sh
# initramfs-tools hook of the Boswas OS boot screen (installed as
# /usr/share/initramfs-tools/hooks/boswas-bootsplash).
#
# Puts the daemon and its client into the initramfs. The client is also made
# available there as /bin/plymouth: that is the program Debian's disk-unlock
# helper (/lib/cryptsetup/askpass) and the initramfs scripts call to ask for
# a passphrase and to show messages. The link exists only inside the
# initramfs image; nothing on the root file system is called plymouth, and
# the package conflicts with plymouth so there is never a second one.
set -e

PREREQ=""

prereqs()
{
	echo "${PREREQ}"
}

case "${1}" in
	prereqs)
		prereqs
		exit 0
		;;
esac

# shellcheck source=/dev/null
. /usr/share/initramfs-tools/hook-functions

# The two programs are all the boot screen needs: its artwork, the glyphs of
# its typeface (Inter) and its colours are built into the daemon, so no font,
# image or theme file is copied here.
copy_exec /usr/libexec/boswas/boswas-bootsplashd
copy_exec /usr/bin/boswas-bootsplash

# /bin/plymouth, in whichever layout the initramfs uses (merged /usr or not).
if [ ! -e "${DESTDIR}/usr/bin/plymouth" ] && [ ! -e "${DESTDIR}/bin/plymouth" ]; then
	ln -s boswas-bootsplash "${DESTDIR}/usr/bin/plymouth"
	if [ ! -e "${DESTDIR}/bin/plymouth" ]; then
		mkdir -p "${DESTDIR}/bin"
		ln -s ../usr/bin/boswas-bootsplash "${DESTDIR}/bin/plymouth"
	fi
fi

# Graphics drivers, so that the display's own driver (i915, amdgpu, radeon,
# nouveau, ...) is loaded before the boot screen starts and the disk
# passphrase prompt is on it from the first moment. Debian's initramfs-tools
# brings no graphics drivers by itself (FRAMEBUFFER=y is understood by
# Ubuntu's only), so this hook copies them, as Debian's Plymouth hook does:
# every DRM driver with the firmware it names, except drivers for hardware
# that cannot show a boot screen worth having. With MODULES=dep only the
# drivers of this machine's graphics devices are taken; with MODULES=list the
# administrator's list is the whole selection.
MODULE_EXCLUDE="mga r128 savage sis tdfx via panfrost"
case "${MODULES-most}" in
	dep)
		for device in /sys/class/drm/card*; do
			module="$(readlink -f "${device}/device/driver/module" 2>/dev/null)" || continue
			[ -e "${module}" ] || continue
			manual_add_modules "$(basename "${module}")"
		done
		;;
	list)
		;;
	*)
		# shellcheck disable=SC2086
		copy_modules_dir kernel/drivers/gpu/drm ${MODULE_EXCLUDE}
		;;
esac

# The drivers of the firmware frame buffer and the small KMS drivers of
# virtual machines, by name, whatever was selected above: until the
# display's own driver has loaded (or where there is none) the boot screen
# runs on these. Modules a kernel does not have are skipped.
manual_add_modules simpledrm bochs cirrus-qemu virtio-gpu vboxvideo vmwgfx hyperv_drm qxl \
	efifb vesafb simplefb
