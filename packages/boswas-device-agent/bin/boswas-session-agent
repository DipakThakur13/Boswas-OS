#!/usr/bin/python3 -IB
"""Boswas session agent: the user's local management service (systemd user unit boswas-session-agent.service)."""

import os
import sys

for _hook in ("BOSWAS_SYSROOT", "BOSWAS_WINAPP_HOME"):
    os.environ.pop(_hook, None)

sys.path.insert(0, "/usr/lib/boswas/python")

from boswas_agent.session_agent import main  # noqa: E402

sys.exit(main())
