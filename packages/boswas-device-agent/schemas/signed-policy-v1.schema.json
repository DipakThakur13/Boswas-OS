{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.boswas.invalid/device/signed-policy-v1.schema.json",
  "title": "Signed device policy envelope",
  "description": "Devices verify the signature with the policy key pinned at enrollment before applying anything.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "algorithm",
    "key_id",
    "document",
    "signature"
  ],
  "properties": {
    "schema": {
      "const": "boswas-signed-policy/1"
    },
    "algorithm": {
      "const": "ed25519"
    },
    "key_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "document": {
      "type": "string",
      "contentEncoding": "base64",
      "description": "Canonical JSON of a policy-v1 document."
    },
    "signature": {
      "type": "string",
      "contentEncoding": "base64",
      "description": "Ed25519 signature over the document bytes."
    }
  }
}
