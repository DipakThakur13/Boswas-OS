{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.boswas.invalid/device/device-event-v1.schema.json",
  "title": "Device events",
  "description": "POST /api/v1/devices/{id}/events: management actions and security events. Local application launches by the user are not reported.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "device_id",
    "events"
  ],
  "properties": {
    "schema": {
      "const": "boswas-device-event/1"
    },
    "device_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "events": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "occurred_at",
          "source",
          "detail"
        ],
        "properties": {
          "type": {
            "enum": [
              "APPLICATION_INSTALLED",
              "APPLICATION_REMOVED",
              "APPLICATION_LAUNCHED",
              "APPLICATION_BLOCKED",
              "APPLICATION_REPAIRED",
              "POLICY_UPDATED",
              "SECURITY_EVENT"
            ]
          },
          "occurred_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          },
          "source": {
            "enum": [
              "local",
              "remote"
            ]
          },
          "detail": {
            "type": "string",
            "maxLength": 300
          },
          "application_id": {
            "type": "string"
          },
          "command_id": {
            "type": "string"
          }
        }
      }
    }
  }
}
