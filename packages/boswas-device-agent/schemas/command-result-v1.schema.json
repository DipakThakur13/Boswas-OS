{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.boswas.invalid/device/command-result-v1.schema.json",
  "title": "Command result",
  "description": "POST /api/v1/devices/{id}/commands/{command_id}/result. Short typed facts only; never program output, logs or user data.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "command_id",
    "device_id",
    "status",
    "result",
    "error",
    "reported_at"
  ],
  "properties": {
    "schema": {
      "const": "boswas-command-result/1"
    },
    "command_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "device_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "status": {
      "enum": [
        "ACKNOWLEDGED",
        "RUNNING",
        "SUCCEEDED",
        "FAILED",
        "EXPIRED"
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "application_id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "app_state": {
          "type": "string"
        },
        "was_running": {
          "type": "boolean"
        },
        "stopped": {
          "type": "boolean"
        },
        "healthy": {
          "type": "boolean"
        },
        "removed": {
          "type": "boolean"
        },
        "installed": {
          "type": "boolean"
        },
        "already": {
          "type": "boolean"
        },
        "inventory_revision": {
          "type": "integer"
        },
        "policy_version": {
          "type": "string"
        },
        "agent_version": {
          "type": "string"
        },
        "started": {
          "type": "boolean"
        }
      }
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
            },
            "message": {
              "type": "string",
              "maxLength": 500
            }
          }
        }
      ]
    },
    "reported_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
