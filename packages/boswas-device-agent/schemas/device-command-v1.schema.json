{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.boswas.invalid/device/device-command-v1.schema.json",
  "title": "Device command (API v1)",
  "description": "Commands the Control Plane may queue for a device. Destructive commands (wipe, retire) are intentionally not part of v1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "issued_at",
    "expires_at",
    "issued_by"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "enum": [
        "SYNC_POLICY",
        "CHECK_UPDATE",
        "INSTALL_UPDATE",
        "RESTART",
        "LOCK_DEVICE",
        "REFRESH_CONFIGURATION"
      ]
    },
    "issued_at": {
      "type": "string"
    },
    "expires_at": {
      "type": "string"
    },
    "issued_by": {
      "type": "string",
      "description": "Opaque Control Plane actor reference (audit), not a user identity."
    },
    "parameters": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
