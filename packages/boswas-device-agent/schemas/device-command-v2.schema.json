{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.boswas.invalid/device/device-command-v2.schema.json",
  "title": "Device command (typed management operation)",
  "description": "A typed operation queued by the Control Plane. There is no command type that carries a shell command, script, program path or code; destructive device operations (wipe, retire) do not exist.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "command_id",
    "device_id",
    "type",
    "payload",
    "created_at",
    "expires_at",
    "created_by"
  ],
  "properties": {
    "schema": {
      "const": "boswas-device-command/2"
    },
    "command_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "device_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "type": {
      "enum": [
        "INSTALL_APPLICATION",
        "UPDATE_APPLICATION",
        "REMOVE_APPLICATION",
        "LAUNCH_APPLICATION",
        "STOP_APPLICATION",
        "REPAIR_APPLICATION",
        "REFRESH_INVENTORY",
        "APPLY_POLICY",
        "UPDATE_AGENT"
      ]
    },
    "payload": {
      "type": "object",
      "description": "Validated per type (boswas_agent.commands.PAYLOAD_VALIDATORS)."
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "expires_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "created_by": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}:[A-Za-z0-9._@-]{1,96}$",
      "description": "Opaque Control Plane actor reference for the audit trail, not a user identity."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "INSTALL_APPLICATION",
              "UPDATE_APPLICATION"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "application_id",
              "version",
              "installer",
              "manifest"
            ],
            "properties": {
              "application_id": {
                "type": "string",
                "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+$"
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "installer": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "sha256",
                  "size",
                  "file_name"
                ],
                "properties": {
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "size": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "file_name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255
                  }
                }
              },
              "manifest": {
                "$ref": "https://schemas.boswas.invalid/compat/manifest-v1.schema.json"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "REMOVE_APPLICATION",
              "LAUNCH_APPLICATION",
              "STOP_APPLICATION",
              "REPAIR_APPLICATION"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "application_id"
            ],
            "properties": {
              "application_id": {
                "type": "string",
                "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "REFRESH_INVENTORY"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [],
            "properties": {}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "APPLY_POLICY"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "policy_version"
            ],
            "properties": {
              "policy_version": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "UPDATE_AGENT"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "version"
            ],
            "properties": {
              "version": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._~+:-]{0,63}$"
              }
            }
          }
        }
      }
    }
  ]
}
