{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.boswas.invalid/device/compliance-report-v1.schema.json",
  "title": "Compliance report (API v1)",
  "description": "POST /api/v1/devices/{id}/compliance. Check IDs and results only (local self-assessment, not attested).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "device_id",
    "policy_version",
    "summary",
    "checks",
    "assessed_at",
    "basis"
  ],
  "properties": {
    "schema": {
      "const": "boswas-compliance-report/1"
    },
    "device_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "policy_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "pass",
        "warn",
        "fail",
        "unknown"
      ],
      "properties": {
        "state": {
          "enum": [
            "COMPLIANT",
            "NON_COMPLIANT",
            "PENDING",
            "UNKNOWN"
          ]
        },
        "pass": {
          "type": "integer",
          "minimum": 0
        },
        "warn": {
          "type": "integer",
          "minimum": 0
        },
        "fail": {
          "type": "integer",
          "minimum": 0
        },
        "unknown": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "scored"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "WARN",
              "FAIL",
              "INFO",
              "UNKNOWN"
            ]
          },
          "scored": {
            "type": "boolean"
          }
        }
      }
    },
    "assessed_at": {
      "type": "string"
    },
    "basis": {
      "type": "string"
    }
  }
}
