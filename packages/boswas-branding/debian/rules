#!/usr/bin/make -f
# Renders the Boswas OS artwork from the SVG sources in desktop/ (repository
# root is two levels up) and installs every file with an explicit mode.
#
#   desktop/branding/   the mark, wordmarks, boot and login art, splash, Plymouth
#   desktop/presets/    the ten presets: colour schemes, Global Themes,
#                       wallpapers, Konsole schemes, boswas-preset (install.sh)
#   desktop/icons/      the Boswas and Boswas Light icon themes (install.sh)
#   desktop/launcher/   the Boswas Launcher applet
#   desktop/terminal/   the Boswas terminal prompt and welcome
#   desktop/defaults/   system-wide KDE, SDDM and lock-screen defaults

REPO   := $(abspath $(CURDIR)/../..)
SUBST  := $(REPO)/build/scripts/subst-release.sh
INLINE := python3 $(REPO)/build/scripts/inline-svg.py
DESK   := $(REPO)/desktop
B      := build
PKG    := debian/boswas-branding
SHARE  := $(PKG)/usr/share
BRAND  := $(SHARE)/boswas/branding
SPLASH := $(SHARE)/plasma/look-and-feel/com.boswas.splash
PLY    := $(SHARE)/plymouth/themes/boswas
KDEDEF := $(SHARE)/boswas/kde-settings
ORBITRON := Regular Medium SemiBold Bold ExtraBold Black

%:
	dh $@

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	cd $(DESK)/presets && python3 -B -m unittest discover -s tests
	cd $(DESK)/icons && python3 -B -m unittest discover -s tests
endif

override_dh_auto_build:
	mkdir -p $(B)/plymouth
	# Self-contained SVGs (Qt cannot follow <image> references)
	$(INLINE) $(DESK)/branding/boswas-mark.svg $(B)/boswas-logo.svg
	$(INLINE) $(DESK)/branding/boswas-about-logo.svg $(B)/boswas-about-logo.svg
	$(INLINE) $(DESK)/branding/boswas-os-mark.svg $(B)/boswas-os-mark.svg
	$(INLINE) $(DESK)/branding/login-logo.svg $(B)/boswas-login-logo.svg
	$(INLINE) $(DESK)/branding/plymouth/watermark.svg $(B)/lockup.svg
	# Plymouth (two-step): lockup, 24-frame spinner, passphrase dialog
	rsvg-convert --height 190 $(B)/lockup.svg -o $(B)/plymouth/watermark.png
	for f in entry lock bullet capslock; do \
		rsvg-convert $(DESK)/branding/plymouth/$$f.svg -o $(B)/plymouth/$$f.png || exit 1; \
	done
	for i in $$(seq 1 24); do \
		n=$$(printf %04d $$i); \
		sed "s/@ANGLE@/$$((i * 15))/" $(DESK)/branding/plymouth/throbber.svg | \
			rsvg-convert -o $(B)/plymouth/throbber-$$n.png || exit 1; \
		cp $(B)/plymouth/throbber-$$n.png $(B)/plymouth/animation-$$n.png; \
	done
	# KDE defaults
	cat $(DESK)/defaults/kde-settings/kdeglobals.header $(DESK)/presets/color-schemes/BoswasHorizon.colors > $(B)/kdeglobals
	$(SUBST) < $(DESK)/defaults/kde-settings/kcm-about-distrorc.in > $(B)/kcm-about-distrorc

override_dh_auto_install:
	install -D -m 0644 $(B)/boswas-logo.svg $(BRAND)/boswas-logo.svg
	install -D -m 0644 $(B)/boswas-about-logo.svg $(BRAND)/boswas-about-logo.svg
	install -D -m 0644 $(B)/boswas-os-mark.svg $(BRAND)/boswas-os-mark.svg
	install -D -m 0644 $(B)/boswas-login-logo.svg $(BRAND)/boswas-login-logo.svg
	install -D -m 0644 $(B)/boswas-logo.svg $(SHARE)/icons/hicolor/scalable/apps/boswas-logo.svg
	# Brand typeface: Orbitron (SIL OFL 1.1, not packaged by Debian). The static
	# instances only; the variable font would duplicate the family in font pickers.
	for weight in $(ORBITRON); do \
		install -D -m 0644 $(DESK)/fonts/orbitron/static/Orbitron-$$weight.ttf \
			$(SHARE)/fonts/truetype/orbitron/Orbitron-$$weight.ttf || exit 1; \
	done
	# The ten presets (colour schemes, Global Themes com.boswas.<id>, wallpapers,
	# lock-screen art, Konsole schemes and profiles, boswas-preset) and the
	# icon themes
	sh $(DESK)/presets/install.sh $(CURDIR)/$(PKG)
	sh $(DESK)/icons/install.sh $(CURDIR)/$(PKG)
	# Session start-up splash (KSplash)
	install -D -m 0644 $(DESK)/branding/splash/metadata.json $(SPLASH)/metadata.json
	install -D -m 0644 $(DESK)/branding/splash/contents/splash/Splash.qml $(SPLASH)/contents/splash/Splash.qml
	install -D -m 0644 $(B)/lockup.svg $(SPLASH)/contents/splash/images/lockup.svg
	install -D -m 0644 $(DESK)/branding/splash/spinner.svg $(SPLASH)/contents/splash/images/spinner.svg
	# Boot, shutdown and passphrase splash (Plymouth)
	install -D -m 0644 $(DESK)/branding/plymouth/boswas.plymouth $(PLY)/boswas.plymouth
	for f in $(B)/plymouth/*.png; do \
		install -D -m 0644 $$f $(PLY)/$$(basename $$f) || exit 1; \
	done
	# Boswas Launcher (Kickoff's maintained implementation under the Boswas name)
	install -D -m 0644 $(DESK)/launcher/metadata.json $(SHARE)/plasma/plasmoids/com.boswas.launcher/metadata.json
	# Terminal: prompt and welcome for the Boswas Konsole profiles
	install -D -m 0644 $(DESK)/terminal/bashrc $(SHARE)/boswas/terminal/bashrc
	install -D -m 0755 $(DESK)/terminal/boswas-welcome $(PKG)/usr/bin/boswas-welcome
	install -D -m 0644 $(DESK)/terminal/boswas-welcome.1 $(SHARE)/man/man1/boswas-welcome.1
	install -D -m 0644 $(DESK)/presets/man/boswas-preset.1 $(SHARE)/man/man1/boswas-preset.1
	# KDE defaults (XDG config dir) and the session hook that enables it
	install -D -m 0644 $(B)/kdeglobals $(KDEDEF)/kdeglobals
	install -D -m 0644 $(DESK)/defaults/kde-settings/kscreenlockerrc $(KDEDEF)/kscreenlockerrc
	install -D -m 0644 $(DESK)/defaults/kde-settings/ksplashrc $(KDEDEF)/ksplashrc
	install -D -m 0644 $(DESK)/defaults/kde-settings/konsolerc $(KDEDEF)/konsolerc
	install -D -m 0644 $(B)/kcm-about-distrorc $(KDEDEF)/kcm-about-distrorc
	install -D -m 0644 $(DESK)/defaults/plasma-workspace-env/boswas-kde-settings.sh \
		$(PKG)/etc/xdg/plasma-workspace/env/boswas-kde-settings.sh
	# Firefox ESR: no Debian package search among the user's search engines
	install -D -m 0644 $(DESK)/defaults/firefox/policies.json $(PKG)/usr/lib/firefox-esr/distribution/policies.json
	# Login screen (SDDM, Breeze theme with the Boswas background and logo)
	install -D -m 0644 $(DESK)/defaults/sddm/10-boswas.conf $(PKG)/etc/sddm.conf.d/10-boswas.conf
	install -D -m 0644 $(DESK)/defaults/sddm/theme.conf.user $(SHARE)/sddm/themes/breeze/theme.conf.user
