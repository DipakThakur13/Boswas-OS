#!/usr/bin/make -f
# Renders the Boswas OS artwork from the SVG sources in desktop/ (repository
# root is two levels up) and installs every file with an explicit mode.
#
#   desktop/branding/   the mark, wordmarks, boot menu and About art
#   desktop/ui/         Boswas UI tokens and the Prism colour schemes
#   desktop/ui/qt/      boswas_fluent, the Qt toolkit of the Boswas applications
#                       (to the private module directory /usr/lib/boswas/python)
#   desktop/presets/    the ten presets: colour schemes, wallpapers,
#                       boswas-preset (install.sh)
#   desktop/icons/      the Boswas Prism icon pack and the earlier Boswas
#                       icon themes (install.sh)
#   desktop/cursors/    Boswas-Cursors, the pointer theme (install.sh)
#   desktop/terminal/   the prompt and welcome of Boswas Terminal
#   desktop/defaults/   system-wide defaults for KDE applications and Firefox
#
# The desktop itself (compositor, shell, lock and login screens) is the
# package boswas-desktop; the boot screen is boswas-bootsplash.

REPO   := $(abspath $(CURDIR)/../..)
INLINE := python3 $(REPO)/build/scripts/inline-svg.py
DESK   := $(REPO)/desktop
B      := build
PKG    := debian/boswas-branding
SHARE  := $(PKG)/usr/share
BRAND  := $(SHARE)/boswas/branding
KDEDEF := $(SHARE)/boswas/kde-settings
FLUENT := $(PKG)/usr/lib/boswas/python/boswas_fluent
ORBITRON := Regular Medium SemiBold Bold ExtraBold Black

%:
	dh $@

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	cd $(DESK)/ui && python3 -B -m unittest discover -s tests
	# The widget tests skip themselves when PySide6 is not installed
	cd $(DESK)/ui/qt && QT_QPA_PLATFORM=offscreen python3 -B -m unittest discover -s tests
	cd $(DESK)/presets && python3 -B -m unittest discover -s tests
	cd $(DESK)/icons && python3 -B -m unittest discover -s tests
	cd $(DESK)/cursors && python3 -B -m unittest discover -s tests
endif

override_dh_auto_build:
	mkdir -p $(B)
	# Self-contained SVGs (Qt cannot follow <image> references)
	$(INLINE) $(DESK)/branding/boswas-mark.svg $(B)/boswas-logo.svg
	$(INLINE) $(DESK)/branding/boswas-about-logo.svg $(B)/boswas-about-logo.svg
	$(INLINE) $(DESK)/branding/boswas-os-mark.svg $(B)/boswas-os-mark.svg
	$(INLINE) $(DESK)/branding/login-logo.svg $(B)/boswas-login-logo.svg
	# Defaults for KDE applications: the Prism colour scheme and icon pack
	cat $(DESK)/defaults/kde-settings/kdeglobals.header $(DESK)/ui/color-schemes/BoswasPrism.colors > $(B)/kdeglobals

override_dh_auto_install:
	install -D -m 0644 $(B)/boswas-logo.svg $(BRAND)/boswas-logo.svg
	install -D -m 0644 $(B)/boswas-about-logo.svg $(BRAND)/boswas-about-logo.svg
	install -D -m 0644 $(B)/boswas-os-mark.svg $(BRAND)/boswas-os-mark.svg
	install -D -m 0644 $(B)/boswas-login-logo.svg $(BRAND)/boswas-login-logo.svg
	install -D -m 0644 $(B)/boswas-logo.svg $(SHARE)/icons/hicolor/scalable/apps/boswas-logo.svg
	# Brand typeface: Orbitron (SIL OFL 1.1, not packaged by Debian). The static
	# instances only; the variable font would duplicate the family in font pickers.
	for weight in $(ORBITRON); do \
		install -D -m 0644 $(DESK)/fonts/orbitron/static/Orbitron-$$weight.ttf \
			$(SHARE)/fonts/truetype/orbitron/Orbitron-$$weight.ttf || exit 1; \
	done
	# Boswas UI: the design tokens (for tools that read them) and the Prism
	# colour schemes for KDE applications
	install -D -m 0644 $(DESK)/ui/tokens.json $(SHARE)/boswas/ui/tokens.json
	for scheme in BoswasPrism BoswasPrismLight; do \
		install -D -m 0644 $(DESK)/ui/color-schemes/$$scheme.colors $(SHARE)/color-schemes/$$scheme.colors || exit 1; \
	done
	# boswas_fluent: the Qt toolkit every Boswas application imports
	install -d -m 0755 $(FLUENT) $(FLUENT)/widgets
	install -m 0644 $(DESK)/ui/qt/boswas_fluent/*.py $(FLUENT)/
	install -m 0644 $(DESK)/ui/qt/boswas_fluent/widgets/*.py $(FLUENT)/widgets/
	# The ten presets (colour schemes, wallpapers, lock-screen art,
	# boswas-preset) and the icon themes: Boswas Prism (the default) and the
	# earlier Boswas themes
	sh $(DESK)/presets/install.sh $(CURDIR)/$(PKG)
	sh $(DESK)/icons/install.sh $(CURDIR)/$(PKG) all
	# The pointer theme of the desktop. The maintainer scripts register it
	# as Debian's default cursor theme (the x-cursor-theme alternative).
	sh $(DESK)/cursors/install.sh $(CURDIR)/$(PKG)
	# Terminal: the prompt and welcome Boswas Terminal starts bash with
	install -D -m 0644 $(DESK)/terminal/bashrc $(SHARE)/boswas/terminal/bashrc
	install -D -m 0755 $(DESK)/terminal/boswas-welcome $(PKG)/usr/bin/boswas-welcome
	install -D -m 0644 $(DESK)/terminal/boswas-welcome.1 $(SHARE)/man/man1/boswas-welcome.1
	install -D -m 0644 $(DESK)/presets/man/boswas-preset.1 $(SHARE)/man/man1/boswas-preset.1
	# Defaults for KDE applications (an XDG config dir that boswas-session
	# appends, so /etc/xdg and the user's own settings keep precedence)
	install -D -m 0644 $(B)/kdeglobals $(KDEDEF)/kdeglobals
	# Firefox ESR: no Debian package search among the user's search engines
	install -D -m 0644 $(DESK)/defaults/firefox/policies.json $(PKG)/usr/lib/firefox-esr/distribution/policies.json
