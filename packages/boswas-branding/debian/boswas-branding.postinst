#!/bin/sh
# Boswas-Cursors is the pointer theme of the desktop. Programs that do not
# read XCURSOR_THEME (GTK and X11 clients) load the theme called "default",
# which in Debian is the alternative x-cursor-theme: register the Boswas
# theme there, above the themes Debian's packages register (Adwaita 90,
# Breeze 102), so the pointer is the same in every program.
set -e

if [ "$1" = configure ]; then
	update-alternatives --install /usr/share/icons/default/index.theme x-cursor-theme \
		/usr/share/icons/Boswas-Cursors/cursor.theme 150
fi

#DEBHELPER#
