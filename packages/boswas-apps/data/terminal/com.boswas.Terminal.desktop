[Desktop Entry]
Type=Application
Name=Terminal
GenericName=Terminal Emulator
Comment=Use the command line
Exec=boswas-terminal
Icon=boswas-terminal
Terminal=false
StartupNotify=true
StartupWMClass=com.boswas.Terminal
Categories=System;TerminalEmulator;
Keywords=terminal;shell;command line;prompt;console;bash;ssh;
Actions=NewWindow;
X-TerminalArgExec=-e
X-TerminalArgTitle=--title
X-TerminalArgDir=--working-directory

[Desktop Action NewWindow]
Name=New Window
Exec=boswas-terminal --new-window
