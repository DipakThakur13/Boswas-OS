#!/usr/bin/make -f
# Boswas sysops: the privileged helper. Python modules go to the private
# module directory shared with the other Boswas packages
# (/usr/lib/boswas/python); the helper itself lives in /usr/libexec/boswas
# (started through pkexec only, never in PATH). Every file is installed with
# an explicit mode.

PKG   := debian/boswas-sysops
PYDIR := $(PKG)/usr/lib/boswas/python/boswas_sysops

%:
	dh $@

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	python3 -B -m unittest discover -s tests -v
endif

override_dh_auto_install:
	install -D -m 0755 bin/sysops $(PKG)/usr/libexec/boswas/sysops
	install -d -m 0755 $(PYDIR)
	install -m 0644 boswas_sysops/*.py $(PYDIR)/
	install -D -m 0644 data/com.boswas.sysops.policy $(PKG)/usr/share/polkit-1/actions/com.boswas.sysops.policy
	install -D -m 0644 data/apps.conf $(PKG)/etc/boswas/apps.conf
	install -D -m 0644 data/flatpak-remotes/flathub.flatpakrepo \
		$(PKG)/usr/share/boswas/sysops/flatpak-remotes/flathub.flatpakrepo
