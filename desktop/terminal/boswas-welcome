#!/bin/sh
# boswas-welcome: the short system summary Boswas OS terminals start with.
# Reads only local files (no network, no root, no slow commands), so opening a
# terminal stays instant. Turn it off per user with: touch ~/.config/boswas/no-welcome
set -u

release=/usr/lib/boswas/release
name="Boswas OS" version="" version_id=""
if [ -r "$release" ]; then
	name="$(sed -n 's/^BOSWAS_NAME="\(.*\)"$/\1/p' "$release")"
	version="$(sed -n 's/^BOSWAS_VERSION="\(.*\)"$/\1/p' "$release")"
	version_id="$(sed -n 's/^BOSWAS_VERSION_ID="\(.*\)"$/\1/p' "$release")"
fi

if [ -e /run/live/medium ] || [ "$(cat /run/boswas/session 2>/dev/null)" = "live" ]; then
	session="Live session (changes are not kept after shutdown)"
else
	session="Installed"
fi

apparmor="off"
[ "$(cat /sys/module/apparmor/parameters/enabled 2>/dev/null)" = "Y" ] && apparmor="on"

agent=""
status=/var/lib/boswas/agent/status.json
if [ -r "$status" ]; then
	agent="$(sed -n 's/.*"state": *"\([A-Z_]*\)".*/\1/p' "$status" | head -n 1)"
fi

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-dumb}" != "dumb" ]; then
	gold="$(printf '\033[1;38;2;227;191;126m')" silver="$(printf '\033[38;2;174;183;199m')" off="$(printf '\033[0m')"
else
	gold="" silver="" off=""
fi

printf '\n  %sWelcome to %s%s %s%s%s\n' "$gold" "$name" "$off" "$version" "${version_id:+ ($version_id)}" ""
printf '  %sKernel%s %s  %s|%s  %s\n' "$silver" "$off" "$(uname -r)" "$silver" "$off" "$(uname -m)"
printf '  %sSession%s %s\n' "$silver" "$off" "$session"
printf '  %sSecurity%s AppArmor %s%s\n' "$silver" "$off" "$apparmor" "${agent:+  |  device agent $agent}"
printf '  %sboswas status%s security posture   %sboswas-info%s system details\n\n' "$silver" "$off" "$silver" "$off"
