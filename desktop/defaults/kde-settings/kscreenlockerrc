# Boswas OS screen lock policy (installed by boswas-branding as
# /usr/share/boswas/kde-settings/kscreenlockerrc).
#
# [$i] marks a key immutable (KDE Kiosk): users cannot disable automatic
# locking, lock-on-resume, or lengthen the idle timeout (minutes).

[Daemon]
Autolock[$i]=true
LockOnResume[$i]=true
Timeout[$i]=10

# Lock screen wallpaper of the default preset (Boswas Horizon); boswas-preset
# writes the user's own choice.
[Greeter][Wallpaper][org.kde.image][General]
Image=file:///usr/share/boswas/presets/lock/horizon.png
