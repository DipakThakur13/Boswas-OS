# Boswas OS system-wide defaults for KDE applications (installed by
# boswas-branding as /usr/share/boswas/kde-settings/kdeglobals; generated
# from this header plus desktop/ui/color-schemes/BoswasPrism.colors, the
# colours of the Boswas desktop). Users and /etc/xdg override.

[KDE]
widgetStyle=Breeze

[Icons]
Theme=Boswas-Prism

