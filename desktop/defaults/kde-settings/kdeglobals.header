# Boswas OS system-wide KDE defaults (installed by boswas-branding as
# /usr/share/boswas/kde-settings/kdeglobals; generated from this header plus
# desktop/presets/color-schemes/BoswasHorizon.colors, the default preset).
# Users and /etc/xdg override.

[KDE]
LookAndFeelPackage=com.boswas.horizon
widgetStyle=Breeze

[Icons]
Theme=Boswas

