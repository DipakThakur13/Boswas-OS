[Plymouth Theme]
Name=Boswas OS
Description=Boswas OS boot, shutdown and passphrase screen: the Boswas OS mark with a gold spinner.
ModuleName=two-step

[two-step]
ImageDir=/usr/share/plymouth/themes/boswas
DialogHorizontalAlignment=.5
DialogVerticalAlignment=.72
TitleHorizontalAlignment=.5
TitleVerticalAlignment=.72
HorizontalAlignment=.5
VerticalAlignment=.66
WatermarkHorizontalAlignment=.5
WatermarkVerticalAlignment=.42
Transition=none
TransitionDuration=0.0
BackgroundStartColor=0x0b1220
BackgroundEndColor=0x080c16
ProgressBarBackgroundColor=0x24324a
ProgressBarForegroundColor=0xd9b26e
MessageBelowAnimation=true

[boot-up]
UseEndAnimation=false

[shutdown]
UseEndAnimation=false

[reboot]
UseEndAnimation=false

[updates]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Installing updates...
SubTitle=Do not turn off your computer

[system-upgrade]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Upgrading Boswas OS...
SubTitle=Do not turn off your computer

[firmware-upgrade]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Upgrading firmware...
SubTitle=Do not turn off your computer

[system-reset]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Resetting Boswas OS...
SubTitle=Do not turn off your computer
