[Icon Theme]
Name=Boswas Prism Light
Comment=Boswas OS icons in the Prism palette, for light panels: colour tiles for applications, folders, devices and file types, dark symbolic icons; Breeze for everything else
Inherits=breeze,Adwaita,hicolor
Example=boswas-logo

# Default sizes, as in Breeze, so switching icon theme does not resize the desktop
DesktopDefault=48
DesktopSizes=16,22,32,48,64,128,256
ToolbarDefault=22
ToolbarSizes=16,22,32,48
MainToolbarDefault=22
MainToolbarSizes=16,22,32,48
SmallDefault=16
SmallSizes=16,22,32,48
PanelDefault=48
PanelSizes=16,22,32,48,64,128,256
DialogDefault=32
DialogSizes=16,22,32,48,64,128,256

# The coloured icons (apps, places, devices, mimetypes) are installed from
# desktop/icons/Boswas-Prism by desktop/icons/install.sh; only the symbolic
# icons (status, actions) differ and are kept here.
Directories=scalable/apps,scalable/places,scalable/devices,scalable/mimetypes,scalable/status,scalable/actions

[scalable/apps]
Size=256
MinSize=16
MaxSize=512
Type=Scalable
Context=Applications

[scalable/places]
Size=256
MinSize=16
MaxSize=512
Type=Scalable
Context=Places

[scalable/devices]
Size=256
MinSize=16
MaxSize=512
Type=Scalable
Context=Devices

[scalable/mimetypes]
Size=256
MinSize=16
MaxSize=512
Type=Scalable
Context=MimeTypes

[scalable/status]
Size=16
MinSize=8
MaxSize=512
Type=Scalable
Context=Status

[scalable/actions]
Size=16
MinSize=8
MaxSize=512
Type=Scalable
Context=Actions
