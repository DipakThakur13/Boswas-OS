[Icon Theme]
Name=Boswas Prism
Comment=Boswas OS icons in the Prism palette, for dark panels: coloured objects lit from the top for Boswas programs, folders, devices and file types, light line icons for status and actions; other applications keep their own icons, Breeze Dark draws everything else
# hicolor first: an application's own icon (installed into hicolor) wins over
# Breeze's drawing of it; Breeze Dark still gives the generic action icons.
Inherits=hicolor,breeze-dark,breeze,Adwaita
Example=boswas-logo

# Default sizes, as in Breeze, so switching icon theme does not resize the desktop
DesktopDefault=48
DesktopSizes=16,22,32,48,64,128,256
ToolbarDefault=22
ToolbarSizes=16,22,32,48
MainToolbarDefault=22
MainToolbarSizes=16,22,32,48
SmallDefault=16
SmallSizes=16,22,32,48
PanelDefault=48
PanelSizes=16,22,32,48,64,128,256
DialogDefault=32
DialogSizes=16,22,32,48,64,128,256

Directories=scalable/apps,scalable/places,scalable/devices,scalable/mimetypes,scalable/status,scalable/actions

[scalable/apps]
Size=256
MinSize=16
MaxSize=512
Type=Scalable
Context=Applications

[scalable/places]
Size=256
MinSize=16
MaxSize=512
Type=Scalable
Context=Places

[scalable/devices]
Size=256
MinSize=16
MaxSize=512
Type=Scalable
Context=Devices

[scalable/mimetypes]
Size=256
MinSize=16
MaxSize=512
Type=Scalable
Context=MimeTypes

[scalable/status]
Size=16
MinSize=8
MaxSize=512
Type=Scalable
Context=Status

[scalable/actions]
Size=16
MinSize=8
MaxSize=512
Type=Scalable
Context=Actions
