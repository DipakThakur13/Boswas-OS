{
  "name": "Boswas UI",
  "version": 3,
  "palette": "Prism",
  "design": "Fluent: the layout, geometry, materials and motion follow the Fluent (WinUI) design language; colours, icons and typefaces are Boswas's own.",
  "color": {
    "ink": {
      "950": "#0B0A12",
      "900": "#12101C",
      "800": "#1A1728",
      "700": "#252136",
      "600": "#332E48",
      "500": "#4A4563"
    },
    "cloud": {
      "50": "#F6F4FC",
      "100": "#ECE9F7",
      "200": "#D8D4E8",
      "400": "#A7A2BF",
      "600": "#5C5775"
    },
    "iris": {
      "300": "#B7AAFF",
      "400": "#9B8AFF",
      "500": "#7C5CFF",
      "600": "#6443E6",
      "700": "#4C31BD"
    },
    "azure": {
      "300": "#8FC2FF",
      "400": "#5CA3FF",
      "500": "#2F7FF0",
      "600": "#1E63D0",
      "700": "#164CA6"
    },
    "mint": {
      "300": "#7FE5BF",
      "400": "#45D3A0",
      "500": "#17A877",
      "600": "#0E8A60",
      "700": "#0A6B4B"
    },
    "sun": {
      "300": "#FFDA8C",
      "400": "#FFC24F",
      "500": "#FFA91F",
      "600": "#E3860A",
      "700": "#B86605",
      "800": "#8A4A00"
    },
    "coral": {
      "300": "#FFA1AD",
      "400": "#FF7788",
      "500": "#EE4B66",
      "600": "#CC3353",
      "700": "#A22441"
    },
    "sky": {
      "300": "#8FDDF7",
      "400": "#57C8F2",
      "500": "#1A9FD9",
      "600": "#0E80B8",
      "700": "#0A6491"
    },
    "orchid": {
      "300": "#F0A8E9",
      "400": "#E27DD8",
      "500": "#C44FBA",
      "600": "#A2399A",
      "700": "#7E2A78"
    },
    "slate": {
      "300": "#9BA2B9",
      "400": "#747B95",
      "500": "#565C76",
      "600": "#3E435B",
      "700": "#2C3044"
    },
    "neutral": {
      "25": "#FAFAFC",
      "50": "#F3F3F5",
      "100": "#E9E8ED",
      "200": "#D9D8DF",
      "300": "#BDBCC6",
      "400": "#9F9EAA",
      "500": "#65646F",
      "600": "#4A4953",
      "700": "#393840",
      "800": "#2C2B32",
      "900": "#201F25",
      "950": "#18171C"
    },
    "white": "#FFFFFF",
    "black": "#000000"
  },
  "brand": {
    "comment": "The official Boswas OS mark keeps its own gold and silver (desktop/branding/README.md). These are never used as UI colours.",
    "gold": "#D9B26E",
    "silver": "#AEB7C7"
  },
  "semantic": {
    "dark": {
      "background": "neutral.900",
      "surface": "neutral.800",
      "surface-raised": "neutral.700",
      "surface-hover": "neutral.600",
      "chrome": "neutral.950",
      "border": "neutral.600",
      "text": "white",
      "text-secondary": "neutral.200",
      "text-muted": "neutral.300",
      "accent": "iris.400",
      "accent-hover": "iris.300",
      "accent-pressed": "iris.500",
      "on-accent": "ink.950",
      "focus": "white",
      "success": "mint.400",
      "warning": "sun.400",
      "danger": "coral.400",
      "info": "azure.400"
    },
    "light": {
      "background": "neutral.50",
      "surface": "white",
      "surface-raised": "neutral.25",
      "surface-hover": "neutral.100",
      "chrome": "neutral.100",
      "border": "neutral.200",
      "text": "neutral.950",
      "text-secondary": "neutral.600",
      "text-muted": "neutral.500",
      "accent": "iris.600",
      "accent-hover": "iris.500",
      "accent-pressed": "iris.700",
      "on-accent": "white",
      "focus": "neutral.950",
      "success": "mint.600",
      "warning": "sun.800",
      "danger": "coral.600",
      "info": "azure.600"
    }
  },
  "stroke": {
    "comment": "One-pixel outlines, as an opacity of 'color' over whatever lies beneath.",
    "dark": {
      "color": "white",
      "control": 0.07,
      "surface": 0.1,
      "divider": 0.08,
      "window": 0.14
    },
    "light": {
      "color": "black",
      "control": 0.07,
      "surface": 0.09,
      "divider": 0.07,
      "window": 0.2
    }
  },
  "fill": {
    "comment": "State layers of controls, as an opacity of 'color' over the surface. 'subtle' controls have no fill at rest.",
    "dark": {
      "color": "white",
      "control": 0.06,
      "control-hover": 0.09,
      "control-pressed": 0.04,
      "subtle-hover": 0.07,
      "subtle-pressed": 0.04,
      "disabled": 0.04
    },
    "light": {
      "color": "black",
      "control": 0.03,
      "control-hover": 0.06,
      "control-pressed": 0.09,
      "subtle-hover": 0.05,
      "subtle-pressed": 0.08,
      "disabled": 0.03
    }
  },
  "material": {
    "comment": "Mica and acrylic are drawn from the desktop wallpaper: blurred by 'blur' logical pixels and covered with 'tint' at 'tint-opacity'. Mica is for window chrome and long-lived surfaces, acrylic for flyouts and menus, chrome for the taskbar, smoke dims what lies behind a dialog.",
    "mica": {
      "tint": "@background",
      "tint-opacity": 0.84,
      "blur": 96
    },
    "acrylic": {
      "tint": "@surface",
      "tint-opacity": 0.78,
      "blur": 48
    },
    "chrome": {
      "tint": "@chrome",
      "tint-opacity": 0.86,
      "blur": 48
    },
    "smoke": {
      "tint": "black",
      "tint-opacity": 0.32,
      "blur": 0
    }
  },
  "icon": {
    "comment": "Boswas Prism icon pack: one hue per category. Tiles run from 'from' to 'to'; 'glyph' is the line colour and 'accent' the single highlight element.",
    "hues": {
      "iris": {
        "from": "iris.500",
        "to": "iris.700",
        "glyph": "white",
        "accent": "sun.300"
      },
      "azure": {
        "from": "azure.500",
        "to": "azure.700",
        "glyph": "white",
        "accent": "sun.300"
      },
      "mint": {
        "from": "mint.500",
        "to": "mint.700",
        "glyph": "white",
        "accent": "sun.300"
      },
      "sun": {
        "from": "sun.300",
        "to": "sun.500",
        "glyph": "ink.900",
        "accent": "iris.600"
      },
      "coral": {
        "from": "coral.500",
        "to": "coral.700",
        "glyph": "white",
        "accent": "sun.300"
      },
      "sky": {
        "from": "sky.600",
        "to": "sky.700",
        "glyph": "white",
        "accent": "sun.300"
      },
      "orchid": {
        "from": "orchid.500",
        "to": "orchid.700",
        "glyph": "white",
        "accent": "sun.300"
      },
      "slate": {
        "from": "slate.500",
        "to": "slate.700",
        "glyph": "white",
        "accent": "iris.300"
      },
      "ink": {
        "from": "ink.600",
        "to": "ink.800",
        "glyph": "white",
        "accent": "iris.400"
      }
    }
  },
  "radius": {
    "control": 4,
    "card": 4,
    "window": 8,
    "flyout": 8,
    "tooltip": 4,
    "pill": 999
  },
  "spacing": {
    "unit": 4
  },
  "type": {
    "family": [
      "Inter",
      "Noto Sans",
      "Lato",
      "DejaVu Sans"
    ],
    "display-family": "Orbitron",
    "scale": [
      12,
      14,
      16,
      20,
      28,
      40
    ],
    "ramp": {
      "comment": "[size, line height, weight] in logical pixels.",
      "caption": [
        12,
        16,
        400
      ],
      "body": [
        14,
        20,
        400
      ],
      "body-strong": [
        14,
        20,
        600
      ],
      "body-large": [
        16,
        22,
        400
      ],
      "subtitle": [
        20,
        28,
        600
      ],
      "title": [
        28,
        36,
        600
      ],
      "title-large": [
        40,
        52,
        600
      ]
    }
  },
  "elevation": {
    "desktop": {
      "blur": 0,
      "y": 0,
      "alpha": 0.0
    },
    "tooltip": {
      "blur": 8,
      "y": 4,
      "alpha": 0.22
    },
    "window": {
      "blur": 32,
      "y": 12,
      "alpha": 0.34
    },
    "flyout": {
      "blur": 16,
      "y": 8,
      "alpha": 0.3
    },
    "dialog": {
      "blur": 48,
      "y": 20,
      "alpha": 0.48
    }
  },
  "motion": {
    "fast-ms": 150,
    "normal-ms": 200,
    "slow-ms": 250,
    "curve": "ease-out-cubic",
    "curves": {
      "decelerate": [
        0.1,
        0.9,
        0.2,
        1.0
      ],
      "accelerate": [
        0.7,
        0.0,
        1.0,
        0.5
      ],
      "standard": [
        0.8,
        0.0,
        0.2,
        1.0
      ]
    },
    "reduced-motion": "all durations become 0"
  },
  "shell": {
    "comment": "Fixed geometry of the desktop shell and the window frames, in logical pixels.",
    "taskbar-height": 48,
    "taskbar-button": 40,
    "taskbar-icon": 24,
    "taskbar-indicator": [
      6,
      3
    ],
    "taskbar-indicator-active": [
      16,
      3
    ],
    "start-width": 642,
    "start-height": 726,
    "start-columns": 6,
    "start-rows": 3,
    "start-icon": 32,
    "flyout-margin": 12,
    "quick-settings-width": 360,
    "notification-width": 364,
    "toast-width": 364,
    "titlebar-height": 32,
    "caption-button": [
      46,
      32
    ],
    "caption-close-hover": "#C42B1C",
    "caption-close-pressed": "#B02A1F",
    "window-border": 1,
    "resize-margin": 8,
    "tooltip-delay-ms": 500
  }
}
