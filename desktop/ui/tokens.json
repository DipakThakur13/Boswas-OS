        "to": "orchid.600",
        "light": "orchid.300",
        "deep": "orchid.700",
        "glyph": "white",
        "accent": "sun.300"
      },
      "slate": {
        "from": "slate.400",
        "to": "slate.600",
        "light": "slate.300",
        "deep": "slate.700",
        "glyph": "white",
        "accent": "sky.400"
