      "success": "mint.600",
      "warning": "sun.800",
      "danger": "coral.600",
      "info": "azure.600"
    }
  },
  "stroke": {
    "comment": "One-pixel outlines, as an opacity of 'color' over whatever lies beneath.",
    "dark": {
      "color": "white",
      "control": 0.07,
      "surface": 0.1,
      "divider": 0.08,
      "window": 0.14
    },
    "light": {
      "color": "black",
      "control": 0.07,
      "surface": 0.09,
      "divider": 0.07,
      "window": 0.2
    }
  },
  "fill": {
    "comment": "State layers of controls, as an opacity of 'color' over the surface. 'subtle' controls have no fill at rest.",
    "dark": {
      "color": "white",
      "control": 0.06,
      "control-hover": 0.09,
      "control-pressed": 0.04,
      "subtle-hover": 0.07,
      "subtle-pressed": 0.04,
      "disabled": 0.04
    },
    "light": {
      "color": "black",
      "control": 0.03,
      "control-hover": 0.06,
      "control-pressed": 0.09,
      "subtle-hover": 0.05,
      "subtle-pressed": 0.08,
      "disabled": 0.03
    }
  },
  "material": {
    "comment": "Mica and acrylic are drawn from the desktop wallpaper: blurred by 'blur' logical pixels and covered with 'tint' at 'tint-opacity'. Mica is for window chrome and long-lived surfaces, acrylic for flyouts and menus, chrome for the taskbar, smoke dims what lies behind a dialog.",
    "mica": {
      "tint": "@background",
      "tint-opacity": 0.84,
      "blur": 96
    },
    "acrylic": {
      "tint": "@surface",
      "tint-opacity": 0.78,
      "blur": 48
    },
    "chrome": {
      "tint": "@chrome",
      "tint-opacity": 0.86,
      "blur": 48
    },
    "smoke": {
      "tint": "black",
      "tint-opacity": 0.32,
      "blur": 0
    },
    "glass": {
      "comment": "Boswas glass, the material of the Boswas applications (boswas_fluent). A window shows the desktop background as its backdrop: blurred by 'blur' logical pixels, its colours saturated by 'saturation', covered with 'tint' at the scheme's 'tint-opacity' (raised where the picture would leave text under 4.5:1) and with a fine grain of 'noise' opacity, so the wide soft areas do not band. Panes, cards, rows, menus and dialogs lie on it as translucent glass: 'pane', 'card' and 'flyout' are the opacities of 'pane-tint', 'card-tint' and 'flyout-tint'; 'highlight' is the white hairline of their top and left edges ('highlight-hover' under the pointer), 'glow' the white inner glow below their top edge, 'shadow' the black of their lower edge and of the soft shadow of raised glass. With transparency effects off, or with a high-contrast preset, every surface is its opaque tint.",
      "tint": "@background",
      "tint-opacity": 0.7,
      "blur": 80,
      "saturation": 1.3,
      "noise": 0.03,
      "pane-tint": "@background",
      "card-tint": "@surface",
      "flyout-tint": "@surface",
      "dark": {
        "tint-opacity": 0.7,
        "pane": 0.34,
        "card": 0.56,
        "flyout": 0.84,
        "highlight": 0.12,
        "highlight-hover": 0.22,
        "glow": 0.05,
        "shadow": 0.32
      },
      "light": {
        "tint-opacity": 0.6,
        "pane": 0.4,
        "card": 0.7,
        "flyout": 0.86,
        "highlight": 0.85,
        "highlight-hover": 1.0,
        "glow": 0.5,
        "shadow": 0.08
      }
    }
  },
  "icon": {
    "comment": "Boswas Prism icon pack: objects without a tile, lit from the top. 'hues' are the colour families of the objects. A part runs from 'from' (its lit top) to 'to' (its bottom); a lighter part (a front flap, a lid) runs from 'light' to 'from', a part behind or in shade from 'to' to 'deep'. 'glyph' is a symbol drawn on the hue, 'accent' the colour of the part that carries the meaning. 'materials' are the neutral parts (paper, metal, glass), with the same keys. 'light' is the highlight along top edges, the shade where parts overlap and the soft contact shadow under every object.",
    "hues": {
      "azure": {
        "from": "azure.400",
        "to": "azure.600",
        "light": "azure.300",
        "deep": "azure.700",
        "glyph": "white",
        "accent": "sun.400"
      },
      "sky": {
        "from": "sky.400",
        "to": "sky.600",
        "light": "sky.300",
        "deep": "sky.700",
        "glyph": "white",
        "accent": "sun.400"
      },
      "iris": {
        "from": "iris.400",
        "to": "iris.600",
        "light": "iris.300",
        "deep": "iris.700",
        "glyph": "white",
        "accent": "sun.400"
      },
      "mint": {
        "from": "mint.400",
        "to": "mint.600",
        "light": "mint.300",
        "deep": "mint.700",
        "glyph": "white",
        "accent": "sun.400"
      },
      "sun": {
