{
  "name": "Boswas UI",
  "version": 2,
  "palette": "Prism",
  "color": {
    "ink": {
      "950": "#0B0A12",
      "900": "#12101C",
      "800": "#1A1728",
      "700": "#252136",
      "600": "#332E48",
      "500": "#4A4563"
    },
    "cloud": {
      "50": "#F6F4FC",
      "100": "#ECE9F7",
      "200": "#D8D4E8",
      "400": "#A7A2BF",
      "600": "#5C5775"
    },
    "iris": {
      "300": "#B7AAFF",
      "400": "#9B8AFF",
      "500": "#7C5CFF",
      "600": "#6443E6",
      "700": "#4C31BD"
    },
    "azure": {
      "300": "#8FC2FF",
      "400": "#5CA3FF",
      "500": "#2F7FF0",
      "600": "#1E63D0",
      "700": "#164CA6"
    },
    "mint": {
      "300": "#7FE5BF",
      "400": "#45D3A0",
      "500": "#17A877",
      "600": "#0E8A60",
      "700": "#0A6B4B"
    },
    "sun": {
      "300": "#FFDA8C",
      "400": "#FFC24F",
      "500": "#FFA91F",
      "600": "#E3860A",
      "700": "#B86605",
      "800": "#8A4A00"
    },
    "coral": {
      "300": "#FFA1AD",
      "400": "#FF7788",
      "500": "#EE4B66",
      "600": "#CC3353",
      "700": "#A22441"
    },
    "sky": {
      "300": "#8FDDF7",
      "400": "#57C8F2",
      "500": "#1A9FD9",
      "600": "#0E80B8",
      "700": "#0A6491"
    },
    "orchid": {
      "300": "#F0A8E9",
      "400": "#E27DD8",
      "500": "#C44FBA",
      "600": "#A2399A",
      "700": "#7E2A78"
    },
    "slate": {
      "300": "#9BA2B9",
      "400": "#747B95",
      "500": "#565C76",
      "600": "#3E435B",
      "700": "#2C3044"
    },
    "white": "#FFFFFF",
    "black": "#000000"
  },
  "brand": {
    "comment": "The official Boswas OS mark keeps its own gold and silver (desktop/branding/README.md). These are never used as UI colours.",
    "gold": "#D9B26E",
    "silver": "#AEB7C7"
  },
  "semantic": {
    "dark": {
      "background": "ink.950",
      "surface": "ink.900",
      "surface-raised": "ink.800",
      "surface-hover": "ink.700",
      "border": "ink.600",
      "text": "cloud.50",
      "text-secondary": "cloud.200",
      "text-muted": "cloud.400",
      "accent": "iris.500",
      "accent-hover": "iris.400",
      "accent-pressed": "iris.600",
      "on-accent": "white",
      "focus": "iris.300",
      "success": "mint.400",
      "warning": "sun.400",
      "danger": "coral.400",
      "info": "azure.400"
    },
    "light": {
      "background": "cloud.50",
      "surface": "white",
      "surface-raised": "cloud.100",
      "surface-hover": "cloud.200",
      "border": "cloud.200",
      "text": "ink.900",
      "text-secondary": "ink.600",
      "text-muted": "cloud.600",
      "accent": "iris.600",
      "accent-hover": "iris.500",
      "accent-pressed": "iris.700",
      "on-accent": "white",
      "focus": "iris.500",
      "success": "mint.600",
      "warning": "sun.800",
      "danger": "coral.600",
      "info": "azure.600"
    }
  },
  "icon": {
    "comment": "Boswas Prism icon pack: one hue per category. Tiles run from 'from' to 'to'; 'glyph' is the line colour and 'accent' the single highlight element.",
    "hues": {
      "iris": { "from": "iris.500", "to": "iris.700", "glyph": "white", "accent": "sun.300" },
      "azure": { "from": "azure.500", "to": "azure.700", "glyph": "white", "accent": "sun.300" },
      "mint": { "from": "mint.500", "to": "mint.700", "glyph": "white", "accent": "sun.300" },
      "sun": { "from": "sun.300", "to": "sun.500", "glyph": "ink.900", "accent": "iris.600" },
      "coral": { "from": "coral.500", "to": "coral.700", "glyph": "white", "accent": "sun.300" },
      "sky": { "from": "sky.600", "to": "sky.700", "glyph": "white", "accent": "sun.300" },
      "orchid": { "from": "orchid.500", "to": "orchid.700", "glyph": "white", "accent": "sun.300" },
      "slate": { "from": "slate.500", "to": "slate.700", "glyph": "white", "accent": "iris.300" },
      "ink": { "from": "ink.600", "to": "ink.800", "glyph": "white", "accent": "iris.400" }
    }
  },
  "radius": {
    "control": 4,
    "window": 8,
    "card": 8,
    "flyout": 12,
    "pill": 999
  },
  "spacing": {
    "unit": 4
  },
  "type": {
    "family": ["Inter", "Noto Sans", "Lato", "DejaVu Sans"],
    "display-family": "Orbitron",
    "scale": [12, 14, 16, 20, 28, 40]
  },
  "elevation": {
    "desktop": { "blur": 0, "y": 0, "alpha": 0.0 },
    "window": { "blur": 24, "y": 8, "alpha": 0.35 },
    "flyout": { "blur": 32, "y": 12, "alpha": 0.45 },
    "dialog": { "blur": 48, "y": 16, "alpha": 0.55 }
  },
  "motion": {
    "fast-ms": 150,
    "normal-ms": 200,
    "slow-ms": 250,
    "curve": "ease-out-cubic",
    "reduced-motion": "all durations become 0"
  }
}
