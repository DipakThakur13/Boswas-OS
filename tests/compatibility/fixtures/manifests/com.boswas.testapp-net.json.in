{
  "schemaVersion": 1,
  "id": "com.boswas.testapp-net",
  "name": "Boswas Test App (network)",
  "version": "1.0",
  "runtime": {"type": "wine", "wineVersion": "10"},
  "architecture": "x86_64",
  "launch": "boswas-testapp.exe",
