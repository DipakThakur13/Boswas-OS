# Boswas OS builder image.
#
# A Debian 13 "trixie" environment containing exactly the tooling needed to
# build Boswas packages and the live ISO. Used by `./build.sh --container`
# on hosts that are not Debian 13 (Windows/WSL, macOS, other distributions).
#
# The base tag is overridable so a release build can pin an image digest:
#   docker build --build-arg BASE_IMAGE=debian@sha256:<digest> ...
ARG BASE_IMAGE=debian:trixie
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

# live-build + its runtime helpers, Debian packaging toolchain (dh-apparmor
# for boswas-compat), asset rendering (librsvg + the Lato typeface used by
# Boswas branding), and the tooling used by test.sh: ISO inspection, the QEMU
# boot test, apparmor_parser (profile compile checks), the MinGW
# cross-compilers that build the 64-bit and 32-bit Windows test application
# from source (tests/compatibility/fixtures/), openssl (device credentials and signed
# policies in the agent and Control Plane tests) and PySide6 with Qt's
# offscreen platform (Compatibility Manager widget tests), and the Rust
# toolchain with the libraries the native desktop (boswas-desktop) and the
# boot screen (boswas-bootsplash) are built against. cargo downloads the
# crates pinned in their Cargo.lock files from crates.io.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        live-build debootstrap \
        xorriso squashfs-tools mtools dosfstools cpio xz-utils zstd \
        grub-common grub-efi-amd64-bin grub-pc-bin \
        wget curl ca-certificates gnupg rsync file git \
        build-essential dpkg-dev debhelper dh-apparmor fakeroot lintian \
        librsvg2-bin fonts-lato potrace netpbm \
        python3 openssl \
        python3-pyside6.qtcore python3-pyside6.qtgui python3-pyside6.qtwidgets qt6-qpa-plugins \
        python3-pyside6.qtsvg python3-pyside6.qtdbus python3-pyside6.qtnetwork \
        python3-pyside6.qtmultimedia python3-pyside6.qtpdf python3-pyside6.qtprintsupport \
        qt6-image-formats-plugins dbus-daemon xwayland x11-apps grim desktop-file-utils \
        apparmor gcc-mingw-w64-x86-64-win32 gcc-mingw-w64-i686-win32 \
        cargo rustc pkgconf \
        libgbm-dev libinput-dev libpam0g-dev libpixman-1-dev libseat-dev libudev-dev libxkbcommon-dev \
        fonts-inter \
        qemu-system-x86 qemu-utils ovmf \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

# The X11 socket directory that systemd-tmpfiles (x11.conf) creates on every
# booted system. Without it XWayland finds no free display socket, and the
# compositor's X11 test (boswas-desktop, run at package build) times out.
RUN install -d -m 1777 /tmp/.X11-unix

LABEL org.opencontainers.image.title="boswas-os-builder" \
      org.opencontainers.image.description="Debian 13 trixie build environment for Boswas OS" \
      org.opencontainers.image.vendor="Boswas Group"

WORKDIR /src
