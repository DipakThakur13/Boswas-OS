# Build products (regenerated by ./build.sh)
/build/output/
/build/logs/
/build/cache/
/build/manifest/
/build/work/

# Package build trees
/packages/*/build/
/packages/*/debian/.debhelper/
/packages/*/debian/debhelper-build-stamp
/packages/*/debian/files
/packages/*/debian/*.substvars
/packages/*/debian/boswas-*/
/packages/*.deb
/packages/*.buildinfo
/packages/*.changes
/control-plane/debian/.debhelper/
/control-plane/debian/debhelper-build-stamp
/control-plane/debian/files
/control-plane/debian/*.substvars
/control-plane/debian/boswas-*/

# Python
__pycache__/
*.pyc

# Never commit key material (repository signing keys live in the HSM / key
# custody process, see docs/architecture/update-architecture.md)
*.key
*.pem
*.p12
*.pfx
*.sec
secring.*
private-keys-v1.d/
